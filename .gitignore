# 构建产物
target/
dist-npm/
dist-win/
# E2E 取证产物（scripts/e2e-evidence.sh 写给 check-static 对账用）：
# 里面记的是本机日志的绝对路径与当机运行时版本，属本机产物，不入库
dist/
*.o
*.a
*.so
*.dll
*.log
*.zip

# 单文件包：打好的 exe 随仓库分发（便于不装 SDK 的人直接拿到），
# 其余都是本机产物——work/ 是打包用的临时构建副本，*.WebView2/ 是运行时用户数据。
# 前缀 **/ 不能省：带中间斜杠的规则会锚定到本文件所在目录，只写 dist-single/work/ 匹配不到示例下那份
**/dist-single/work/
**/dist-single/store.json
**/dist-single/notes/
**/dist-single/*.WebView2/

# Linux 目录式便携包（scripts/pack-linux.sh 产物：main + lib/ + ui/ + capabilities/ + 可选 bin/cjh）
# 注意这里必须写 /*（写 **/dist-linux/ 会把目录整个排除，后面的 ! 对目录内的文件不生效）——
# ai-chat 那份 tar.gz 随仓分发，与 dist-single 的 exe 同理：不装 SDK 的人解包即用。
**/dist-linux/*
!examples/ai-chat/dist-linux/*.tar.gz

# 示例自带的 cjh 预编译包随仓分发（更新方式：把 cjh 仓 dist/ 里的新版本包拷进 vendor/cjh/，
# 连同 SHA256SUMS 一起换）。上面第 13 行的 *.zip 会连它一起吃掉，这里按目录放行。
!examples/ai-chat/vendor/cjh/*.zip
!examples/ai-chat/vendor/cjh/*.tar.gz
# cjnote 同款：它按 vendor/cjh/bin/<平台>/ 直接找现成二进制（没有运行期解包），所以除了压缩包
# 还带一棵 bin/ 树；树里 Windows 侧按名字加载的 DLL 由 examples/cjnote/.gitignore 放行。
!examples/cjnote/vendor/cjh/*.zip
!examples/cjnote/vendor/cjh/*.tar.gz

# 本地环境
cjpm.lock
__pycache__/
*.stdx.bak
# 单测宏展开的中间产物（cjpm test 生成在 src/tests/ 下）
*.macrocall
# AtomCode 的本地会话产物（skills/ 已在仓库里单独分发，这份目录不入库）
.atomcode/

# 本机运行数据（示例落盘的成绩等，不进仓）
*.local.json

# store 插件的运行期数据：文件名是硬编码的 store.json，落在应用的 cwd（示例根）下
examples/*/store.json
# Markdown 笔记示例的工作区：由 run.sh / E2E 入口播种（mkdir -p notes + 欢迎笔记），不入库
examples/markdown-notes/notes/
# HTTP 客户端示例的工作区：envs / collections / history 由应用运行期写入（E2E 跑前会清干净，
# 自检断言只在干净工作区口径下成立），不入库
examples/http-client/data/
# SQLite 浏览器示例的夹具库：由 fixture.py / E2E 入口每轮重建，且运行期会被页面写入（自检那条 INSERT），不入库
examples/sqlite-browser/data/

# 系统文件
.DS_Store

# 自检/导出的本地产物（mb:export 落盘目录）
logs/

# 本地留档、不入库（用户裁定：推广渠道与素材只留本机）
docs/推广渠道与提交素材.md

# 力扣示例的代码草稿（本机数据，不入库）
examples/leetcode-gui/ui/.draft.json
