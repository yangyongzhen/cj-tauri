{
  "identifier": "app",
  "windows": ["main"],
  "commands": [
    "http:get",
    "http:post",
    "http:delete",
    "http:postStream",
    "ws:connect",
    "ws:send",
    "ws:close",
    "store:get",
    "store:set",
    "store:del",
    "store:keys",
    "log:write",
    "log:path",
    "clipboard:write",
    "fs:readText",
    "dialog:open",
    "dialog:pickFolder",
    "quit",
    "cjh:status",
    "cjh:start",
    "cjh:deploy",
    "system:version",
    "system:host"
  ],
  "events": ["http:chunk", "ws:frame", "ws:state"],
  "permissions": ["http:default", "store:default", "log:default", "ws:default"],
  "scopes": {
    "http": {
      "allow": [
        "api.deepseek.com",
        "api.openai.com",
        "open.bigmodel.cn",
        "dashscope.aliyuncs.com",
        "api.moonshot.cn",
        "*.openai.azure.com",
        "127.0.0.1",
        "localhost"
      ]
    },
    "ws": {
      "allow": ["127.0.0.1", "localhost"]
    },
    "fs": {
      "allow": ["$HOME/**"],
      "deny": ["**/.ssh/**", "**/.aws/**", "**/.git-credentials", "**/id_rsa*", "**/*.pem"]
    }
  }
}
