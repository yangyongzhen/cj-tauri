package music_next_app

import cjTauri.*
import cjTauri.platform.*
import music_next.*
import std.fs.*

// assets/ 与 capabilities/ 按启动时工作目录相对读取；从 targets/<端>/ 直接启动会找不到
//（issue #6-②，实测「资产未找到」秒退）——向上探两级回到项目根；都找不到就原样返回，
// 让框架按自己的口径报错。
func findDir(rel: String): String {
    if (exists(rel)) { return rel }
    if (exists("../" + rel)) { return "../" + rel }
    if (exists("../../" + rel)) { return "../../" + rel }
    return rel
}

main(): Int64 {
    let spec = build()
        .page(PageSource.Asset("ui/index.html"))
        .window(WindowConfig("仓颉爱音乐 · cj-tauri", 1280, 820))
        .assets(DirectoryAssetResolver(findDir("assets")))
        .capabilities(findDir("assets/capabilities"))
    launch(spec)
    return 0
}
