// 鸿蒙侧框架装配（批次 3-PR3，RFC §4.2/§4.6.5）：业务装配点 music_next.build() 三端共用
package ohos_app_cangjie_entry

import kit.PerformanceAnalysisKit.Hilog
import cjTauri.*
import cjTauri.platform.*
import music_next.*
import ohos.resource_manager.*

/**
 * rawfile 资产解析器（L0，RFC §6.2）：hap 里没有工程目录，Asset 只能从 rawfile 解析。
 * 与桌面 DirectoryAssetResolver 同形：以「能否读到」为准，失败 = None（host_arkweb 在其上如实报错）。
 */
class RawfileAssetResolver <: AssetResolver {
    private let rm: ResourceManager

    public init(rm: ResourceManager) {
        this.rm = rm
    }

    public func readText(name: String): Option<String> {
        try {
            return Some(String.fromUtf8(this.rm.getRawFileContent(name)))
        } catch (e: Exception) {
            return None
        }
    }

    public func exists(name: String): Bool {
        return readText(name).isSome()
    }
}

/** 读 hap 里的 rawfile（失败返回空串并打一行 hilog；调用方按「空 = 没有」降级，不让异常冒到生命周期） */
func readRawText(rm: ResourceManager, path: String): String {
    try {
        return String.fromUtf8(rm.getRawFileContent(path))
    } catch (e: Exception) {
        Hilog.info(1, "CjTauri", "rawfile ${path} 读取失败: ${e}")
        return ""
    }
}

/**
 * 装配并运行框架应用（非 UI 线程调用；run() 阻塞到 quit()）
 *
 * 页面取清单 [assets] page（sync 生成时已校验存在）；能力清单是构建期拷进 hap 的
 * rawfile/capabilities/*.json——文件名单是清单侧的真相，由生成器逐个渲染。
 */
public func startApp(filesDir: String, rm: ResourceManager): Unit {
    Hilog.info(1, "CjTauri", "startApp begin (ohos skeleton, business = music_next.build())")
    // 沙箱目录要在 load 之前给定：宿主把页面落沙箱再以 file:// 加载（与桌面 load(source) 同一契约）
    ArkWebRuntime.configure(filesDir)
    let spec = build()
        .page(PageSource.Asset("ui/index.html"))
        .assets(RawfileAssetResolver(rm))
    let caps0 = readRawText(rm, "capabilities/default.json")
    if (caps0.size > 0) {
        spec.capabilityJson(caps0)
    } else {
        Hilog.info(1, "CjTauri", "rawfile/capabilities/default.json 读不到（构建时打进 hap 了吗？）：命令会被全部拒绝")
    }
    launchWith(spec, Platform.mobile(filesDir, "unknown"))
    Hilog.info(1, "CjTauri", "after run")
}
