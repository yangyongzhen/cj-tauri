{
  "identifier": "default",
  "windows": ["main"],
  "commands": [
    "greet",
    "timer",
    "probeLog",
    "system:version",
    "system:host",
    "clipboard:write",
    "clipboard:read"
  ],
  "permissions": ["menu:state", "http:default", "fs:default", "mqtt:debug", "redis:default"],
  "events": ["tick", "menu:click", "mqtt:message", "mqtt:state"],
  "scopes": {
    "http": {
      "allow": ["www.baidu.com", "httpbin.org"]
    },
    "fs": {
      "allow": ["probe-fs/**", "probe-fs", "probe-fs.txt", "$CWD/probe-fs/**", "$CWD/probe-fs"],
      "deny": ["**/secret*"]
    }
  }
}
