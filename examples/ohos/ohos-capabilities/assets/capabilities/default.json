{
  "identifier": "default",
  "windows": ["main"],
  "commands": [
    "greet",
    "timer",
    "probeLog",
    "system:version",
    "system:host",
    "clipboard:write",
    "clipboard:read"
  ],
  "permissions": ["menu:state", "http:default"],
  "events": ["tick", "menu:click"],
  "scopes": {
    "http": {
      "allow": ["www.baidu.com", "httpbin.org"]
    }
  }
}
