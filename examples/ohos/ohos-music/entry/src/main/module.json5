{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    /* 鸿蒙 PC 必须声明 "2in1"：只写 phone/tablet 时系统按手机应用处理，窗口是竖屏兼容窗
       （实测约 600 宽、歌单与播放器挤成一列）。构建插件默认把 deviceTypes 限制成 phone/tablet，
       靠 entry/build-profile.json5 的 cangjieOptions.checkDeviceTypes=false 放行（2026-10-22 实测）。 */
    "deviceTypes": [
      "2in1",
      "tablet",
      "phone"
    ],
    "deliveryWithInstall": true,
    /* 后台接口是公网 http（examples/music 共用的那台 go-zero 服务），没有这条权限时
       每次请求都死在 `SocketException: Failed to create socket: Operation not permitted.`
       ——页面上表现为「歌单拉取失败：连不上后台接口」，看着像网络不通（2026-10-22 实测）。 */
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "installationFree": false,
    "srcEntry": "ohos_app_cangjie_entry.MyAbilityStage",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "ohos_app_cangjie_entry.MainAbility",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}